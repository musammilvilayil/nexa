# NEXA runtime configuration example
# Copy values into your local process environment. Never commit real secrets.

# Local model
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# Gemini teacher. Set GEMINI_API_KEY only in your local environment/secret store.
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_API_KEY=

# Explicit workspace roots only. Windows separates paths with ';'.
# Example: NEXA_WORKSPACE_ROOTS=C:\NEXA;D:\Projects
NEXA_WORKSPACE_ROOTS=C:\NEXA

# Kernel confirmation TTL in seconds for REMOTE/DESTRUCTIVE actions.
NEXA_PENDING_TTL_SECONDS=300

# Trading defaults. Keep research until evidence/paper validation is complete.
NEXA_TRADING_MODE=research
NEXA_TRADING_SYMBOLS=NIFTY50
NEXA_TRADING_STRATEGIES=adaptive_router_v1
NEXA_MIN_SIGNAL_CONFIDENCE=0.60
NEXA_MAX_NOTIONAL_PER_TRADE=10000
NEXA_MAX_TOTAL_EXPOSURE=25000
NEXA_MAX_RISK_PER_TRADE=250
NEXA_MAX_DAILY_LOSS=500
NEXA_MAX_OPEN_POSITIONS=3
NEXA_ALLOW_SHORT=false
NEXA_REQUIRE_STOP_LOSS=true

# Autonomous paper runtime. The runner remains blocked unless the mandate is
# PAPER_AUTONOMOUS and the strategy has passed the research-to-paper gate.
NEXA_MARKET_DATA_DIR=C:\NEXA\data\market
NEXA_PAPER_POLL_SECONDS=60
NEXA_PAPER_INITIAL_EQUITY=100000
# NEXA_PAPER_DB=C:\NEXA\data\paper_trading.db

# Reviewed live-broker selector. These values NEVER make build_runtime() create a
# broker. Trusted owner-controlled application code must register a reviewed
# factory and explicitly call build_runtime_from_trusted_brokers(). Credentials
# belong in the reviewed broker factory/secret store, not in this file.
# NEXA_LIVE_BROKER_PROVIDER=reviewed_provider_name
# NEXA_LIVE_BROKER_ACCOUNT=optional_non_secret_account_selector

# When a reviewed live broker adapter is explicitly injected, new live entries
# require a timestamped signal no older than this many seconds. Stale/missing
# live-entry signals activate the kill switch. Risk-reducing exits remain allowed.
NEXA_MAX_SIGNAL_AGE_SECONDS=60

# Local control/status API. Loopback is the safe default. A non-loopback bind is
# refused unless NEXA_LOCAL_API_TOKEN is configured. Never commit the real token.
NEXA_LOCAL_API_HOST=127.0.0.1
NEXA_LOCAL_API_PORT=8765
# NEXA_LOCAL_API_TOKEN=

# Local SQLite paths may be overridden if desired.
# NEXA_AUDIT_DB=C:\NEXA\data\actions.db
# NEXA_STRATEGY_DB=C:\NEXA\data\strategy_promotion.db
# NEXA_TRAINING_DB=C:\NEXA\data\training.db
# NEXA_CANDIDATE_DIR=C:\NEXA\data\generated_skills
# NEXA_CAPABILITY_DB=C:\NEXA\data\capabilities.db
# NEXA_CAPABILITIES_DIR=C:\NEXA\data\capabilities

# ── Security Gate ──────────────────────────────────────────────────
# Cooldown (seconds) after confirming a CRITICAL-tier action.
NEXA_CRITICAL_COOLDOWN_SECONDS=5.0

# ── Failsafe Monitor ──────────────────────────────────────────────
# Corner detection: mouse near (0,0) triggers emergency stop.
NEXA_FAILSAFE_CORNER=true
NEXA_FAILSAFE_CORNER_PX=5
# Max computer-use actions per second before rate-limit stop.
NEXA_FAILSAFE_MAX_ACTIONS=10.0
# Max seconds for a single action before timeout stop.
NEXA_FAILSAFE_TIMEOUT=30.0
# Cooldown after a failsafe trigger before new actions are allowed.
NEXA_FAILSAFE_COOLDOWN=5.0
# Comma-separated process names that must never be automated.
# NEXA_BLOCKED_PROCESSES=

# ── Terminal Skill ──────────────────────────────────────────────────
# Default timeout for terminal command execution (seconds).
NEXA_TERMINAL_TIMEOUT=60.0

# ── Voice System (future) ──────────────────────────────────────────
# STT provider: vosk (offline) or gemini (online)
# NEXA_STT_PROVIDER=vosk
# NEXA_VOSK_MODEL_PATH=
# TTS provider: pyttsx3 (offline) or edge-tts (online)
# NEXA_TTS_PROVIDER=pyttsx3
# Voice mode: push_to_talk, continuous, wake_word
# NEXA_VOICE_MODE=push_to_talk
# NEXA_WAKE_WORD=nexa
