# NEXA runtime configuration example
# Copy values into your local process environment. Never commit real secrets.

# Local model
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# Gemini teacher. Set GEMINI_API_KEY only in your local environment/secret store.
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_API_KEY=

# Explicit workspace roots only. Windows separates paths with ';'.
# Example: NEXA_WORKSPACE_ROOTS=C:\NEXA;D:\Projects
NEXA_WORKSPACE_ROOTS=C:\NEXA

# Kernel confirmation TTL in seconds for REMOTE/DESTRUCTIVE actions.
NEXA_PENDING_TTL_SECONDS=300

# Trading defaults. Keep research until evidence/paper validation is complete.
NEXA_TRADING_MODE=research
NEXA_TRADING_SYMBOLS=NIFTY50
NEXA_TRADING_STRATEGIES=adaptive_router_v1
NEXA_MIN_SIGNAL_CONFIDENCE=0.60
NEXA_MAX_NOTIONAL_PER_TRADE=10000
NEXA_MAX_TOTAL_EXPOSURE=25000
NEXA_MAX_RISK_PER_TRADE=250
NEXA_MAX_DAILY_LOSS=500
NEXA_MAX_OPEN_POSITIONS=3
NEXA_ALLOW_SHORT=false
NEXA_REQUIRE_STOP_LOSS=true

# When a reviewed live broker adapter is explicitly injected, new live entries
# require a timestamped signal no older than this many seconds. Stale/missing
# live-entry signals activate the kill switch. Risk-reducing exits remain allowed.
NEXA_MAX_SIGNAL_AGE_SECONDS=60

# Local SQLite paths may be overridden if desired.
# NEXA_AUDIT_DB=C:\NEXA\data\actions.db
# NEXA_STRATEGY_DB=C:\NEXA\data\strategy_promotion.db
# NEXA_TRAINING_DB=C:\NEXA\data\training.db
# NEXA_CANDIDATE_DIR=C:\NEXA\data\generated_skills
